{% extends 'base.html.twig' %}

{% block title %}Hello LieuController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Lieux</h1>

    <p><a href="{{ path('app_lieu_add') }}">Ajouter un lieu</a></p>
    <p><a href="{{ path('app_evenement') }}">Voir les événements</a></p>

    {% for lieu in lieu %}
        <h2><a href="{{ path('app_lieu_show', { id: lieu.id }) }}">{{ lieu.adresse }}</a></h2>
        <p>{{ lieu.evenements|length }} lieux</p>
    {% else %}
        <p>Aucun lieu pour le moment.</p>
    {% endfor %}
</div>
{% endblock %}
