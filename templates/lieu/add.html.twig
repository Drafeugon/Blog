{% extends 'base.html.twig' %}

{% block title %}Ajouter un lieu{% endblock %}

{% block body %}
    <div class="example-wrapper">
        <h1>Ajouter un lieu</h1>

        {{ form_start(form) }}
            {{ form_row(form.adresse) }}
            {{ form_row(form.ville) }}
            {{ form_row(form.code_postal) }}
            {{ form_widget(form.enregister) }}
        {{ form_end(form) }}

        <a href="{{ path('app_lieu') }}">Retour aux lieux</a>
    </div>
{% endblock %}