{% extends 'base.html.twig' %}

{% block title %}{{ article.titre }}{% endblock %}

{% block body %}
    <div class="example-wrapper">
        <h1>{{ article.titre }}</h1>
        <p>Écrit par {{ article.auteur.nom }}</p>
        <p>{{ article.contenu }}</p>
        <a href="{{ path('app_article_edit', {'id': article.id}) }}">Modifier</a>
        <a href="{{ path('app_article_delete', {'id': article.id}) }}">Supprimer</a>
        <a href="{{ path('app_article') }}">Retour à la liste</a>
    </div>
{% endblock %}
