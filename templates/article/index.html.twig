{% extends 'base.html.twig' %}

{% block title %}Hello toi!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {{ controller_name }}! ✅</h1>

    {% for article in articles %}
        <h2>{{ article.titre }}</h2>
        <p>{{ article.contenu }}</p>
        <p>Écrit par {{ article.auteur.nom }}</p>
        <a href="{{ path('app_article_show', {'id': article.id}) }}">Lire l'article</a>
        <a href="{{ path('app_categorie', {'id': article.id}) }}">Voir la catégorie</a>
        <a href="{{ path('app_article_add', {'id': article.id}) }}">Ajouter un article</a>
        <a href="{{ path('app_article_edit', {'id': article.id}) }}">Modifier</a>
        <a href="{{ path('app_article_delete', {'id': article.id}) }}">Supprimer</a>
    {% endfor %}
</div>
{% endblock %}
