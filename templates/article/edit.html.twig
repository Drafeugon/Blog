{% extends 'base.html.twig' %}

{% block title %}Modifier {{ article.titre }}{% endblock %}

{% block body %}
    <div class="example-wrapper">
        <h1>Modifier l’article</h1>

        {{ form_start(form) }}
            {{ form_row(form.titre) }}
            {{ form_row(form.contenu) }}
            {{ form_row(form.date) }}
            {{ form_row(form.categorie) }}
            {{ form_widget(form.enregister) }}
        {{ form_end(form) }}

        <a href="{{ path('app_article', {'id': article.id}) }}">Annuler</a>
    </div>
{% endblock %}