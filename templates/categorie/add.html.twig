{% extends 'base.html.twig' %}

{% block title %}Ajouter une catégorie{% endblock %}

{% block body %}
    <div class="example-wrapper">
        <h1>Ajouter une catégorie</h1>

        {{ form_start(form) }}
            {{ form_row(form.nom) }}
            {{ form_widget(form.enregister) }}
        {{ form_end(form) }}

        <a href="{{ path('app_categorie') }}">Retour aux catégories</a>
    </div>
{% endblock %}