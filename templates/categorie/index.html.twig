{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
    <div class="example-wrapper">
        <h1>Catégories</h1>

        <p><a href="{{ path('app_categorie_add') }}">Ajouter une catégorie</a></p>
        <p><a href="{{ path('app_article') }}">Voir les articles</a></p>

        {% for categorie in categories %}
            <h2><a href="{{ path('app_categorie_show', { id: categorie.id }) }}">{{ categorie.nom }}</a></h2>
            <p>{{ categorie.articles|length }} article(s)</p>
        {% else %}
            <p>Aucune catégorie pour le moment.</p>
        {% endfor %}
    </div>
{% endblock %}
